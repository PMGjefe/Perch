{
  "expo": {
    "name": "Perch",
    "slug": "perch",
    "version": "0.1.0",
    "scheme": "perch",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.perch.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Perch records where you saw a bird so it can appear in your diary and on your map.",
        "NSCameraUsageDescription": "Perch lets you attach a photo to a sighting.",
        "NSPhotoLibraryUsageDescription": "Perch lets you attach a photo from your library to a sighting.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.perch.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C4622D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "${GOOGLE_MAPS_ANDROID_API_KEY}"
        }
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Perch records where you saw a bird so it can appear in your diary and on your map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Perch lets you attach a photo from your library to a sighting.",
          "cameraPermission": "Perch lets you attach a photo to a sighting."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
