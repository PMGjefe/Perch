# Copy to .env and fill in. Values prefixed EXPO_PUBLIC_ are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Android only: Google Maps key for development builds (Expo Go ships its own).
GOOGLE_MAPS_ANDROID_API_KEY=

# Supabase CLI (local stack): OAuth provider credentials, see README.
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
